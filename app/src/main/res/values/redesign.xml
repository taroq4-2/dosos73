    <!-- Supported links -->
    <string name="supported_direct_title">Direct file links</string>
    <string name="supported_direct_body">APK, XAPK, APKS, ZIP, RAR, 7Z, PDF, Office, EPUB, EXE, MSI, DMG, ISO, images, audio and video. The file type is confirmed from its contents, not only its name.</string>
    <string name="supported_github_title">GitHub releases</string>
    <string name="supported_github_body">Release, tag and repository pages list their release files through GitHub\'s public API. Direct asset links work as files.</string>
    <string name="supported_fdroid_title">F-Droid</string>
    <string name="supported_fdroid_body">App pages resolve to the APK of the suggested version from f-droid.org.</string>
    <string name="supported_media_title">Media sites</string>
    <string name="supported_media_body">Public video and audio pages that the bundled media engine can read, with quality and format choices.</string>
    <string name="supported_limits_title">Not supported</string>
    <string name="supported_limits_body">Content behind sign-in, CAPTCHA, payment or DRM, and pages that only show a download button without a public file link. Android packages are saved, never installed automatically.</string>

