    <!-- الروابط المدعومة -->
    <string name="supported_direct_title">روابط الملفات المباشرة</string>
    <string name="supported_direct_body">APK وXAPK وAPKS وZIP وRAR و7Z وPDF وملفات Office وEPUB وEXE وMSI وDMG وISO والصور والصوت والفيديو. يُتحقق من نوع الملف من محتواه لا من اسمه فقط.</string>
    <string name="supported_github_title">إصدارات GitHub</string>
    <string name="supported_github_body">صفحات الإصدارات والوسوم والمستودعات تعرض ملفات الإصدار عبر واجهة GitHub العامة، وروابط الأصول المباشرة تعمل كملفات.</string>
    <string name="supported_fdroid_title">F-Droid</string>
    <string name="supported_fdroid_body">صفحات التطبيقات تُحوَّل إلى ملف APK للإصدار المقترح من f-droid.org.</string>
    <string name="supported_media_title">مواقع الوسائط</string>
    <string name="supported_media_body">صفحات الفيديو والصوت العامة التي يستطيع محرك الوسائط المدمج قراءتها، مع اختيار الجودة والصيغة.</string>
    <string name="supported_limits_title">غير مدعوم</string>
    <string name="supported_limits_body">المحتوى الذي يتطلب تسجيل دخول أو CAPTCHA أو دفعًا أو المحمي بـ DRM، والصفحات التي تعرض زر تنزيل دون رابط ملف عام. تُحفظ حزم Android ولا تُثبَّت تلقائيًا أبدًا.</string>

